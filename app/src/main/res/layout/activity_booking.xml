<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/card_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/gradient_booking_header"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_station"
            android:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Charging Station"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Booking Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <EditText
                android:id="@+id/et_owner_nic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Owner NIC"
                android:inputType="text"
                android:background="@drawable/card_background_elevated"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/et_station_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Station ID"
                android:inputType="text"
                android:background="@drawable/card_background_elevated"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/et_reservation_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Reservation Time (YYYY-MM-DDTHH:MM:SSZ)"
                android:inputType="datetime"
                android:background="@drawable/card_background_elevated"
                android:padding="12dp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btn_create_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Booking"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/button_primary_green"
                android:padding="14dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
